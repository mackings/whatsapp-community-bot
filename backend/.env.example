# HTTP API port — also serves the WebSocket (at /ws) on this same port
PORT=4000

# If set, request a pairing code for this number instead of printing a QR.
# Format: digits only, with country code, no + or spaces (e.g. 15551234567)
PAIRING_NUMBER=

# MongoDB connection — stores both app data and the Baileys auth/session
# state, so a restart never loses the linked WhatsApp session or history.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=whatsapp_community_bot

# Directory where downloaded media (images/video/audio/documents) is stored
MEDIA_DIR=./data/media

# Required for @mention recaps ("what did I miss?") — get one at aistudio.google.com/apikey
GEMINI_API_KEY=

# Morning/evening daily digest schedule (IANA timezone + 24h HH:mm)
DIGEST_TIMEZONE=Africa/Lagos
DIGEST_MORNING_TIME=09:00
DIGEST_EVENING_TIME=18:00

# Web push (browser notifications for announcements) — generate your own with
# `npx web-push generate-vapid-keys`, keep the private key secret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
